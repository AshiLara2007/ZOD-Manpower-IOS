{
  "expo": {
    "name": "ZOD Manpower",
    "slug": "zod-manpower",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zodmanpowerios",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zod.manpower",
      "buildNumber": "1.0.6",
      "jsEngine": "hermes",
      "requireFullScreen": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIStatusBarStyle": "UIStatusBarStyleLightContent",
        "LSApplicationQueriesSchemes": [
          "whatsapp"
        ],
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "associatedDomains": [
        "applinks:zodmanpower.info"
      ]
    },
    "android": {
      "package": "com.zodmanpower.app",
      "versionCode": 7,
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#E6F4FE"
      },
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "zodmanpower.info",
              "pathPrefix": "/candidate"
            },
            {
              "scheme": "https",
              "host": "www.zodmanpower.info",
              "pathPrefix": "/candidate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1a237e"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1a237e",
          "sounds": [
            "./assets/sounds/custom_notification.wav"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "73898b70-ba5c-4ffd-a35a-3e1c519ae4cf"
      }
    },
    "owner": "ashilara2007s-organization"
  }
}
